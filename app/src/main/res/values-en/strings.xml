    <string name="terms_title">Terms and Conditions</string>
    <string name="terms_content_title">Terms and Conditions of Use</string>
    <string name="terms_welcome">Welcome to MediRemind. By using our application, you accept the following terms and conditions.</string>
    <string name="terms_section_1_title">1. Use of the Application</string>
    <string name="terms_section_1_content">MediRemind is an application designed to help you remember to take medications. It does not replace professional medical advice. Always consult with your doctor before starting, changing, or stopping any treatment.</string>
    <string name="terms_section_2_title">2. Privacy and Data</string>
    <string name="terms_section_2_content">We respect your privacy. The data you provide is used solely for the operation of the application. We do not share your information with third parties without your explicit consent. For more details, see our Privacy Policy.</string>
    <string name="terms_section_3_title">3. Responsibility</string>
    <string name="terms_section_3_content">MediRemind is not responsible for any consequences arising from incorrect use of the application or failure to follow medical instructions. The application is a support tool, not a substitute for medical care.</string>
    <string name="terms_section_4_title">4. Intellectual Property</string>
    <string name="terms_section_4_content">All intellectual property rights related to MediRemind, including but not limited to software, design, logos and content, are owned by MediRemind and its licensors.</string>
    <string name="terms_section_5_title">5. Modifications</string>
    <string name="terms_section_5_content">We reserve the right to modify these terms and conditions at any time. Changes will take effect immediately after publication in the application.</string>
    <string name="terms_section_6_title">6. Termination</string>
    <string name="terms_section_6_content">We may terminate or suspend your access to the application immediately, without prior notice or liability, for any reason, including, without limitation, if you breach these Terms and Conditions.</string>
    <string name="terms_section_7_title">7. Applicable Law</string>
    <string name="terms_section_7_content">These terms will be governed and interpreted in accordance with the laws of the user\'s country of residence, without regard to its conflict of laws provisions.</string>
